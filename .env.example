# InfraPilot AI Configuration

# Environment mode: development, production, solohost
ENVIRONMENT=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# Security & Secret key (Generate a random 32-character string for production)
SECRET_KEY=dev-secret-key-infrapilot-ai-change-this-in-production-min32chars
API_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000","http://127.0.0.1:8000","http://127.0.0.1:19420"]

# Database (preserved sqlite database)
DATABASE_URL=sqlite:///./data/piops.db

# Monitoring Settings
METRIC_COLLECTION_INTERVAL_SECONDS=5
HISTORY_RETENTION_HOURS=72

# Ollama AI Configuration
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_TIMEOUT_SECONDS=45

# Pi Network SoloHost Integration
SOLOHOST_MODE=control-center
PI_NETWORK_ENVIRONMENT=sandbox
PI_API_KEY=
PI_APP_ID=infrapilot-ai

# Standalone Agent Communication
AGENT_SHARED_SECRET=dev-agent-secret-key-change-for-production
